{
  "name": "findit",
  "private": true,
  "version": "1.0.0",
  "description": "FindIt \u2013 Intelligent Lost & Found Management System (React frontend + Express backend)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "install:all": "npm install && npm install --prefix backend",
    "backend": "npm start --prefix backend",
    "dev:all": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm start --prefix backend\" \"vite\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "concurrently": "^9.0.1"
  }
}
